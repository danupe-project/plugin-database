{
    "name": "danupe/plugin-database",
    "description": "The Database Plugin",
    "type": "library",
    "require": {
        "php": ">=8.0",
        "danupe/core": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Danupe\\Plugin\\Database\\": "src/",
            "Danupe\\Plugin\\Database\\Classes\\": "src/classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danupe\\Plugin\\Database\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}